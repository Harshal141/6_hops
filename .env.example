NEXT_PUBLIC_BE_URL=https://service-hops.vercel.app
NEXT_PUBLIC_APP_ENV=local   # local | stage | prod
AUTH_SECRET=<same value as the BE>
INTERNAL_API_SECRET=<shared with the BE; sent to /auth/identity>
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=
# Google sign-in (one shared OAuth client for local + prod). A provider with no ID/secret is hidden.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
BLOB_READ_WRITE_TOKEN=   # auto-populated when a Blob store is connected to the project

# Sentry error tracking. With no DSN the SDK is disabled (fine for local dev).
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only: source map upload to hops-xv/hops-fe. A secret (Sentry org auth token).
SENTRY_AUTH_TOKEN=
